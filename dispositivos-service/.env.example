DATABASE_URL=sqlite:///./dispositivos.db
AUTH_SERVICE_URL=http://127.0.0.1:8001
FRONTEND_ORIGIN=http://localhost:5173

# Mismo valor privado que en recepción; no enviarlo al navegador ni al ESP32.
INTERNAL_SERVICE_TOKEN=REEMPLAZAR_CON_SECRETO_COMPARTIDO_CON_RECEPCION
# Opcional: destino de npm run migrate; DATABASE_URL controla el servidor.
# SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD_ENCODED@HOST:5432/postgres?sslmode=verify-full
